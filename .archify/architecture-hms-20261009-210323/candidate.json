  "cards": [
    {
      "dot": "rose",
      "title": "Owner isolation",
      "items": [
        "Administrator IDs scope rooms, bookings, catalog, orders and metrics.",
        "Hotel names label properties; they never grant management access.",
        "Customers may cancel only their own confirmed reservations."
      ]
    },
    {
      "dot": "emerald",
      "title": "Reservation integrity",
      "items": [
        "PostgreSQL row-level locks protect concurrent bookings.",
        "Date-aware availability calculated dynamically from active bookings.",
        "Housekeeping states (ready/dirty/cleaning/maintenance) enforce turnover."
      ]
    },
    {
      "dot": "cyan",
      "title": "Unified checkout billing",
      "items": [
        "Completed food and service orders combine with room stay into one bill.",
        "Pending, declined and cancelled requests are excluded from charges.",
        "Reception staff record payment (cash/card/bank) and check out atomically."
      ]
    },
    {
      "dot": "slate",
      "title": "Security & session management",
      "items": [
        "Async salted scrypt hashing with no plaintext fallback.",
        "Database-backed revocable sessions with per-IP rate limiting.",
        "Single-use staff invitation tokens and private recovery codes."
      ]
    }
  ]
